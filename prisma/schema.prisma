generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  LECTURE
  EXERCISE
  ASSIGNMENT
  EXAM
  PROJECT
  OTHER
}

enum EventPriority {
  LOW
  MEDIUM
  HIGH
}

enum EventSource {
  PDF_IMPORT
  MANUAL
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  fullName       String?
  avatarUrl      String?
  timezone       String   @default("Europe/Oslo")
  emailReminders Boolean  @default(true)
  calendarToken  String   @unique @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  semesters  Semester[]
  courses    Course[]
  events     Event[]
  pdfImports PdfImport[]
  reminders  Reminder[]

  @@map("users")
}

model Semester {
  id        String   @id @default(uuid())
  userId    String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses    Course[]
  events     Event[]
  pdfImports PdfImport[]

  @@index([userId, isActive])
  @@map("semesters")
}

model Course {
  id         String   @id @default(uuid())
  userId     String
  semesterId String
  name       String
  code       String?
  color      String   @default("#3B82F6")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  events   Event[]

  @@index([semesterId])
  @@index([userId])
  @@map("courses")
}

model Event {
  id          String        @id @default(uuid())
  userId      String
  courseId    String
  semesterId  String
  title       String
  description String?
  type        EventType
  startAt     DateTime
  endAt       DateTime?
  isAllDay    Boolean       @default(false)
  isDone      Boolean       @default(false)
  doneAt      DateTime?
  priority    EventPriority @default(MEDIUM)
  location    String?
  url         String?
  notes       String?
  source      EventSource   @default(MANUAL)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester  Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId, startAt])
  @@index([courseId])
  @@index([semesterId, startAt])
  @@index([userId, isDone])
  @@index([userId, isDone, startAt])
  @@map("events")
}

model PdfImport {
  id            String       @id @default(uuid())
  userId        String
  semesterId    String
  originalName  String
  status        ImportStatus @default(PENDING)
  eventsCreated Int          @default(0)
  errorMessage  String?
  claudeModel   String       @default("claude-sonnet-4-6")
  rawResponse   Json?
  createdAt     DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("pdf_imports")
}

model Reminder {
  id         String    @id @default(uuid())
  eventId    String
  userId     String
  remindAt   DateTime
  offsetDays Int       @default(1)
  sent       Boolean   @default(false)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sent, remindAt])
  @@index([eventId])
  @@map("reminders")
}
