# Local Postgres (see .cursor/install.sh). Both URLs can point at :5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/semester_planner?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/semester_planner?schema=public"

# Production on Vercel + Supabase (serverless):
# DATABASE_URL = transaction pooler, port 6543, pgbouncer=true. Used by Prisma Client (lib/prisma.ts).
# DIRECT_URL   = session pooler or direct, port 5432, no pgbouncer. Used by Prisma CLI/migrate (prisma.config.ts).
#
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Do not point DIRECT_URL at :6543. Migrations need a session/direct connection.

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

GEMINI_API_KEY=""
GOOGLE_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
CRON_SECRET=""
